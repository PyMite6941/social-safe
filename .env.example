# Instagram Monitoring Configuration for social-safe
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file to version control

# ===== REQUIRED CREDENTIALS =====
# Your Instagram username (handle)
IG_USERNAME=your_instagram_handle

# Your Instagram password - USE AN APP-SPECIFIC PASSWORD FOR SECURITY
# Go to Instagram Settings → Security → Two-Factor Authentication → App Passwords
IG_PASSWORD=your_app_specific_password_here

# ===== ALERT CONFIGURATION =====
# Email address to send alerts to (also used as FROM address if not set separately)
ALERT_EMAIL=your_alert_email@example.com

# SMTP password for sending alerts (if different from IG_PASSWORD, or use app-specific password for SMTP)
# For Gmail: use an App Password from your Google Account
ALERT_APP_PASSWORD=your_smtp_app_password

# SMTP server settings (defaults to Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

# ===== MONITORING BEHAVIOR =====
# Expected account privacy: 'private' or 'public'
# The tool will alert if the actual privacy setting doesn't match this
EXPECTED_PRIVACY=private

# What to monitor (set to 'false' to disable)
MONITOR_FOLLOWERS=true
MONITOR_FOLLOWING=true

# Alert thresholds - number of changes that trigger an alert in a single check
# Set to 0 to disable threshold (alert on any change)
ALERT_THRESHOLD_NEW_FOLLOWERS=10
ALERT_THRESHOLD_LOST_FOLLOWERS=10
ALERT_THRESHOLD_NEW_FOLLOWING=10
ALERT_THRESHOLD_LOST_FOLLOWING=10

# State file for storing previous follower/following counts (relative to where you run the tool)
STATE_FILE=ig_state.json

# ===== AUDIT CONFIGURATION =====
# Enable privacy audit (true/false)
AUDIT_ENABLED=true

# Audit risk factors (true/false to enable each check)
AUDIT_RISK_ZERO_POSTS=true          # Flag new followers with zero posts
AUDIT_RISK_ZERO_FOLLOWERS=true      # Flag new followers with zero followers
AUDIT_RISK_HIGH_FOLLOWING_RATIO=true # Flag new followers with high following/follower ratio

# Thresholds for audit risk checks
AUDIT_FOLLOWING_RATIO_THRESHOLD=100   # Following/Follower ratio above this is risky
AUDIT_MIN_FOLLOWERS_FOR_RATIO=10      # Minimum followers to apply ratio check (avoid division by zero)
AUDIT_ALERT_THRESHOLD_RISKY=5         # Number of risky new followers that triggers an alert

# ===== ADVANCED =====
# Comma-separated alert methods: email,telegram (telegram placeholder for future)
ALERT_METHODS=email

# Check interval in seconds if running in daemon mode (not used in one-shot mode)
# For cron jobs, set this via your cron schedule instead
CHECK_INTERVAL=3600